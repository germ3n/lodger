{
	"schemaVersion": 1,
	"id": "lodger",
	"version": "${version}",
	"name": "lodger",
	"description": "One quiet presence that moves into your world and learns you. A craftkit mod: the mind is Rust, in this jar's natives.",
	"authors": [
		"razor"
	],
	"license": "MIT",
	"icon": "assets/lodger/icon.png",
	"environment": "*",
	"jars": [
		{
			"file": "META-INF/jars/${craftkit_jar}"
		}
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"craftkit": ">=${craftkit_version}",
		"minecraft": "~${minecraft_version}"
	}
}
